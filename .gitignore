# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings
.claude/settings.local.json

# dataset grezzo scuole MIM (va riscaricato, vedi scripts/transform-scuole.js)
scripts/data/

# Output del censimento del motore Escape (generato da scripts/censimento-motore.js)
censimento-output/

# Schede di gioco Escape: generate da `npm run schede`, mai committate
# (sarebbero una seconda fonte di verita' che invecchia in silenzio).
schede-missioni.md

# Configurazione locale del banco di prova: contiene segreti veri
# (segreto del cron, chiave service_role, token Vercel). Mai committata.
.banco.local.json

# Rapporti del robot del banco: materiale da leggere, non da versionare
banco-robot-*.json
