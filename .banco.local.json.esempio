  "supabaseUrl": "→ Supabase → Project Settings → Data API → Project URL",
  "supabaseServiceRoleKey": "→ Supabase → Project Settings → API keys → service_role (NON la anon)",

  "vercelToken": "→ Vercel → Account Settings → Tokens → Create (scope: il team che possiede kireo)",
  "vercelProjectId": "→ Vercel → progetto kireo → Settings → General → Project ID (prj_...)"
}
